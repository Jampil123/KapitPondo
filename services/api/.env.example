PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Gemini API — powers integrations/ai/gemini.js (proof-photo field
# extraction + the member support chatbot). Leave blank to keep ai.routes.js
# returning 501.
GEMINI_API_KEY=

# Google Cloud Vision API — powers integrations/ocr/googleVision.js (plain
# OCR text extraction). Leave blank to keep ocr.routes.js returning 501.
GOOGLE_VISION_API_KEY=

# Base URL for the live PSGC (Philippine Standard Geographic Code) REST API
# used by modules/address — free, no key required. Only needs setting if the
# default host ever moves; leave blank to use https://psgc.gitlab.io/api.
PSGC_API_BASE_URL=